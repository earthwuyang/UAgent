# Development Environment Variables
# Copy this file to .env.development.local and configure

# Backend API URL
VITE_BACKEND_BASE_URL=localhost:2999

# Enable mock API (for development without backend)
VITE_MOCK_API=false

# Enable mock node event WebSocket (until backend implements endpoint)
# Set to 'true' to use mock WebSocket for node progress tabs feature
VITE_MOCK_NODE_EVENTS=true
