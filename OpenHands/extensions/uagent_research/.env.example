# UAgent Research Extension Environment Variables
# Copy this file to .env and adjust values as needed.

# Toggle automatic research triggering based on classifier confidence
ENABLE_AUTO_RESEARCH_TRIGGER=true
RESEARCH_CONFIDENCE_THRESHOLD=0.7

# Budget and iteration safeguards
RESEARCH_MAX_ITERATIONS=50
RESEARCH_MAX_COST=10.0
RESEARCH_MAX_PARALLEL=3

# Agent coordination settings
# When enabled, the main agent remains responsive while research runs in background.
ENABLE_AGENT_COORDINATION=true
# Seconds between automatic progress polls while coordinating research experiments.
RESEARCH_POLL_INTERVAL=10
# Seconds to cache progress status responses for quick successive queries.
PROGRESS_CACHE_TTL=2
