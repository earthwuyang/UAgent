# Universal Agent environment configuration

# Backend runtime
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# Frontend development server
VITE_DEV_SERVER_PORT=3001
VITE_BACKEND_URL=http://127.0.0.1:8001

BACKEND_RELOAD=false
LLM_API_KEY=${DASHSCOPE_API_KEY}
LLM_BASE_URL=${DASHSCOPE_BASE_URL}
LLM_EXTRA_OPTIONS=
DASHSCOPE_API_KEY=${DASHSCOPE_API_KEY}
# LLM generation configuration
LLM_PROVIDER=litellm
LLM_MODEL=openai/Moonshot-Kimi-K2-Instruct

MAX_TOKENS=8192

# Unified LLM token limits
LLM_MAX_INPUT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=8192

UAGENT_WORKSPACE_DIR=/tmp/uagent-workspace
UAGENT_RETAIN_WORKSPACES=true

# Path to local OpenHands source (mounted into container to override)
# Set to the absolute path of your OpenHands/openhands directory
OPENHANDS_SOURCE_PATH=/Users/wuy/Desktop/code/UAgent/OpenHands/openhands

# Use official OpenHands headless bridge by default
UAGENT_OPENHANDS_V3=1

# UAGENT_OPENHANDS_IMAGE=docker.all-hands.dev/all-hands-ai/runtime:0.57-nikolaik
# UAGENT_OPENHANDS_IMAGE=earthwuyang/uagent:v0.1
UAGENT_OPENHANDS_IMAGE=earthwuyang/uagent-research:v1.0

# Research execution configurations
MAX_RESEARCH_IDEAS=1                   # Max number of research ideas to generate (debug: 1, production: 3-5)
MAX_PARALLEL_IDEAS=1                   # Max number of ideas to process in parallel (debug: 1, production: 2-4)
EXPERIMENTS_PER_HYPOTHESIS=1           # Number of experiments per hypothesis (debug: 1, production: 2-3)

# OpenHands runtime configurations
OPENHANDS_ACTION_TIMEOUT=120           # Timeout in seconds for each OpenHands action (default: 120 seconds = 2 minutes)
OPENHANDS_MAX_ACTION_TIMEOUT=99999999       # Maximum timeout after retries (default: 900 seconds = 15 minutes)
OPENHANDS_RUN_ADAPTIVE_MULTIPLIER=1.75 # Multiplier for timeout on each retry (default: 1.75)
OPENHANDS_RUN_MAX_ATTEMPTS=3           # Maximum number of attempts for run commands (default: 3)
OPENHANDS_PACKAGE_CMD_MIN_TIMEOUT=600  # Minimum timeout for package manager commands (default: 600 seconds = 10 minutes)
CODEACT_MAX_STEPS=999999999                   # Increase headless agent max iterations (default 20)
UAGENT_OPENHANDS_MAX_STEPS=999999999   # Max steps for OpenHands scientific research experiments (default 80)
UAGENT_OPENHANDS_MAX_MINUTES=9999999  # Max minutes for OpenHands scientific research experiments (default 30)
OPENHANDS_AUTO_INSTALL_PLAYWRIGHT=false # Automatically install Playwright in Docker OpenHands startup (default: true)


