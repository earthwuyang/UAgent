# OpenHands-UAgent Configuration
SERVE_FRONTEND=false

# Server Configuration
OPENHANDS_PORT=2999
SERVER_HOST=127.0.0.1
NO_PROXY=localhost,127.0.0.1,host.docker.internal
no_proxy=localhost,127.0.0.1,host.docker.internal

# LLM Configuration
LLM_API_KEY=${DASHSCOPE_API_KEY}
LLM_BASE_URL=${DASHSCOPE_BASE_URL}
LLM_MODEL=openai/qwen3-coder-plus
LLM_NUM_RETRIES=8
LLM_RETRY_MIN_WAIT=15
LLM_RETRY_MAX_WAIT=120
LLM_TIMEOUT=600

# Sandbox Configuration
# Use Docker's internal DNS for macOS compatibility
SANDBOX_LOCAL_RUNTIME_URL=http://localhost
SANDBOX_USE_HOST_NETWORK=false
SANDBOX_TIMEOUT=120
SANDBOX_INITIALIZE_PLUGINS=true
SANDBOX_RUNTIME_CONTAINER_IMAGE=openhands-uagent:v0.1
SANDBOX_KEEP_RUNTIME_ALIVE=false

# Proxy configuration for Docker containers
# These will be passed to the Docker runtime containers
# Format must be a Python dict literal that will be parsed
# Note: SOCKS proxy removed as it requires socksio package
SANDBOX_RUNTIME_STARTUP_ENV_VARS="{'NO_PROXY': 'localhost,127.0.0.1,host.docker.internal', 'no_proxy': 'localhost,127.0.0.1,host.docker.internal'}"

# Agent Configuration
DEFAULT_AGENT=CodeActAgent
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_MAX_THREADS=2

# Workspace
WORKSPACE_BASE=${WORKSPACE_BASE:-$PWD/workspace}
WORKSPACE_MOUNT_PATH=/workspace

# UAgent Research Configuration
ENABLE_AUTO_RESEARCH_TRIGGER=true
RESEARCH_CONFIDENCE_THRESHOLD=0.5
RESEARCH_MAX_ITERATIONS=9999999999
RESEARCH_MAX_COST=9999999999
RESEARCH_MAX_PARALLEL=3

# Runtime selection for headless sessions
# Set to 'local' to avoid Docker dependency on hosts without Docker/buildx
OPENHANDS_HEADLESS_RUNTIME=local
